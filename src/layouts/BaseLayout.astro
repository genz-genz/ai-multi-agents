---
import '../styles/tokens.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'Hello world', description = 'เว็บส่วนตัว แวะมาทักกันได้' } = Astro.props;
const path = Astro.url.pathname;
// DECISIONS D2: three pages, Thai nav labels
const links = [
  { href: '/', label: 'หน้าแรก', current: path === '/' },
  { href: '/about', label: 'รู้จักกัน', current: path.startsWith('/about') },
  { href: '/guestbook', label: 'ทักทาย', current: path.startsWith('/guestbook') },
];
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style is:global>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--ci-bg);
        color: var(--ci-text);
        font-family: var(--ci-font-sans);
        font-size: var(--ci-text-base);
        line-height: var(--ci-leading-normal);
        -webkit-font-smoothing: antialiased;
        /* Thai has no spaces between words — never let a run overflow the gutter */
        overflow-wrap: break-word;
      }
      a { color: var(--ci-primary); text-decoration: none; }
      a:hover { text-decoration: underline; }
      :where(a, button, input, textarea):focus-visible {
        outline: none;
        box-shadow: var(--ci-ring);
        border-radius: 6px;
      }
      .wrap { width: min(720px, 100% - 2rem); margin: 0 auto; }
      main { padding: 2rem 0 4rem; }
      h1, h2 { line-height: var(--ci-leading-tight); font-weight: 700; letter-spacing: -0.01em; color: var(--ci-text); }
      h1 { font-size: var(--ci-text-3xl); margin: 0 0 0.5rem; }
      h2 { font-size: var(--ci-text-xl); margin: 2rem 0 0.75rem; }
      p { margin: 0 0 1rem; }
      .muted { color: var(--ci-text-muted); }
      .card {
        background: var(--ci-surface);
        border: 1px solid var(--ci-border);
        border-radius: var(--ci-radius-lg);
        box-shadow: var(--ci-shadow-sm);
        padding: 1.25rem 1.5rem;
        margin: 1.5rem 0;
      }
      .btn {
        display: inline-block;
        background: var(--ci-primary);
        color: var(--ci-text-on-primary);
        font: inherit;
        font-weight: 700;
        border: 0;
        border-radius: var(--ci-radius);
        padding: 0.75rem 1.25rem;
        min-height: 44px;
        cursor: pointer;
        transition: background var(--ci-transition);
      }
      .btn:hover { background: var(--ci-primary-hover); text-decoration: none; }
      .btn:disabled { opacity: 0.6; cursor: progress; }
      label { display: block; margin: 1rem 0 0.35rem; font-weight: 700; }
      input, textarea {
        font: inherit;
        color: var(--ci-text);
        background: var(--ci-surface);
        border: 1px solid var(--ci-border);
        border-radius: var(--ci-radius);
        padding: 0.7rem 0.9rem;
        width: 100%;
      }
      nav { border-bottom: 1px solid var(--ci-border); }
      nav ul { display: flex; gap: 1.5rem; list-style: none; margin: 0 auto; padding: 1rem 0; }
      nav a { color: var(--ci-text-muted); font-weight: 700; display: inline-block; padding: 0.25rem 0; }
      nav a[aria-current="page"] { color: var(--ci-primary); border-bottom: 2px solid var(--ci-accent); }
    </style>
  </head>
  <body>
    <nav aria-label="หลัก">
      <ul class="wrap">
        {links.map((l) => (
          <li><a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <main class="wrap">
      <slot />
    </main>
  </body>
</html>
